# Supabase Configuration
# Found in your Supabase dashboard: Settings > API

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Site URL — where the PHP API is running
# Used for OAuth redirect URLs (callback after Google login)
SITE_URL=http://localhost:8005

# Client URL — where the React frontend is running
# Used by CORS middleware in index.php to allow cross-origin requests
# In production this becomes your Vercel/Render URL
CLIENT_URL=http://localhost:5173

# Google Gemini API Key
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
